{
  "name": "service-manager",
  "version": "0.3.70",
  "description": "Desktop service manager built with Electron and TypeScript",
  "main": "dist/main/bootstrap.js",
  "packageManager": "pnpm@9.1.2",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && pnpm run build:main && pnpm run build:renderer && pnpm run copy:renderer && pnpm run build:css",
    "build:main": "tsc -p tsconfig.main.json && node scripts/copy-main-runtime.cjs",
    "build:renderer": "tsc -p tsconfig.renderer.json",
    "copy:renderer": "node scripts/copy-renderer.cjs",
    "build:css": "node scripts/build-tailwind.cjs",
    "benchmark:sql-results": "pnpm run build && electron scripts/benchmark-sql-results.cjs",
    "test": "pnpm run build && node --test tests/*.test.js",
    "start": "pnpm run build && electron .",
    "dev": "pnpm run build && electron .",
    "package:mac": "pnpm run build && electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "package:mac:intel": "pnpm run build && electron-builder --mac dmg zip --x64 --publish never",
    "package:win": "pnpm run build && electron-builder --win nsis --publish never",
    "package:linux": "pnpm run build && electron-builder --linux AppImage --x64 --publish never"
  },
  "keywords": [
    "electron",
    "ssh",
    "service-manager",
    "typescript"
  ],
  "license": "MIT",
  "productName": "Service Manager",
  "build": {
    "appId": "com.wuchong.servicemanager",
    "productName": "Service Manager",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "artifactName": "Service-Manager-${version}-${arch}-${os}.${ext}",
    "publish": [
      {
        "provider": "github"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Development",
      "icon": "assets",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "8.1.5"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@kubernetes/client-node": "^1.4.0",
    "@sentry/electron": "^7.15.0",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.9",
    "@tiptap/core": "3.28.0",
    "@tiptap/extension-code-block-lowlight": "3.28.0",
    "@tiptap/extension-image": "3.28.0",
    "@tiptap/extension-table": "3.28.0",
    "@tiptap/pm": "3.28.0",
    "@tiptap/starter-kit": "3.28.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.6.0",
    "asn1": "^0.2.6",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.6.2",
    "highlight.js": "11.11.1",
    "js-yaml": "^5.2.1",
    "lowlight": "3.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ssh2": "^1.15.0"
  }
}
